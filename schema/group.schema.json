{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EX-CT/EXFA-Format/schema/group.schema.json",
  "title": "EXFA Group v1",
  "type": "object",
  "required": ["format", "id", "name", "actors", "relations"],
  "properties": {
    "format": { "const": "exfa/group@1" },
    "id": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "name": { "type": "string" },
    "folder": { "type": "string" },
    "notes": { "type": "string" },
    "actors": { "type": "array", "items": { "type": "object", "required": ["id", "fit_id"], "properties": {
      "id": { "$ref": "common.schema.json#/$defs/opaqueId" },
      "fit_id": { "$ref": "common.schema.json#/$defs/opaqueId" },
      "label": { "type": "string" },
      "role": { "type": "string" }
    }, "additionalProperties": true } },
    "relations": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "source", "targets"], "properties": {
      "id": { "$ref": "common.schema.json#/$defs/opaqueId" },
      "kind": { "enum": ["project", "command"] },
      "source": { "$ref": "common.schema.json#/$defs/opaqueId" },
      "targets": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/opaqueId" } },
      "source_item_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/opaqueId" } },
      "amount": { "type": "number" },
      "distance_m": { "type": ["number", "null"] },
      "enabled": { "type": "boolean" },
      "notes": { "type": "string" }
    }, "additionalProperties": true } }
  },
  "additionalProperties": true
}
